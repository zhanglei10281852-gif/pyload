+    #: any other party -> rejected
+    with pytest.raises(CaptchaTaskSolved):
+        manager.submit_result(claimed.id, "ABCD", "somebody-else")
+
+    with pytest.raises(CaptchaTaskSolved):
+        manager.submit_result(claimed.id, "ABCD", None)
