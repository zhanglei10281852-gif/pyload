+    f2 = make_file(manager, fid=2, pid=1, order=1, status=12)
+    core.thread_manager.active_ids.add(2)
+
+    old_timeout = file_manager_module.ABORT_TIMEOUT
+    file_manager_module.ABORT_TIMEOUT = 0.2
